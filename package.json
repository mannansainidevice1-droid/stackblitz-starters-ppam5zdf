{
  "name": "bhairavi-creations",
  "version": "1.0.0",
  "description": "Production-ready digital platform for BHAIRAVI Creations",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx src/server/index.ts",
    "test": "vitest run src/tests/integration/db.test.ts src/tests/integration/admin_api.test.ts",
    "test:integration": "vitest run src/tests/integration/db.test.ts src/tests/integration/admin_api.test.ts",
    "test:admin": "vitest run src/tests/integration/admin_api.test.ts",
    "test:all": "vitest run",
    "migrate:up": "tsx src/server/db/migrator.ts up",
    "migrate:status": "tsx src/server/db/migrator.ts status",
    "migrate:reset": "tsx src/server/db/migrator.ts reset",
    "seed": "tsx src/server/db/seed.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
