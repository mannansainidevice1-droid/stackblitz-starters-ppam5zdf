# ==============================================================================
# BHAIRAVI CREATIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Zero hardcoded secrets: All credentials must be injected via environment.
# ==============================================================================

# Server Network Configuration
PORT=4001
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration (SQLite WAL Mode)
DATABASE_URL=./data/bhairavi.db
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Security & Cryptographic Secrets
# CRITICAL: Must be at least 32 characters of random entropy in production
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_32_to_64_character_hex_string_session_secret_12345
IP_HASH_SALT=replace_with_random_salt_for_daily_ip_anonymization_salt_2026

# Initial Superadmin Factory Password (Required for automated migrations/bootstrap)
# In production mode, this MUST be changed immediately after installation
SUPERADMIN_DEFAULT_PASSWORD=ChangeMeImmediately123!

# Security Lockout & Abuse Prevention
ADMIN_LOCKOUT_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_AUTH_PER_15_MINUTES=5
RATE_LIMIT_ENQUIRY_MAX_PER_HOUR=5
RATE_LIMIT_EVENTS_PER_MINUTE=60

# Safe File Upload Configuration
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_STORAGE_PATH=./storage/uploads

# External Commerce Integrations
WHATSAPP_BUSINESS_NUMBER=917347278010
AMAZON_ASSOCIATE_TAG=bhairavicreat-21

# Read-Only AI Analyst Scoped Bearer Token (Min 32 characters)
AI_ANALYST_TOKEN=replace_with_ai_analyst_scoped_bearer_token_min_32_chars
